@input input

@slot0 logic.variable

@slot1 logic.variable

@wire0 data.get
source $input key "context"

@wire1 bindings.unit

@wire2 relation.join
"rows" $wire1 "facts" $wire0 "name" "step0" "arg0" "pickup" "arg1" $slot0 "arg2" $slot1

@wire3 relation.join
"rows" $wire2 "facts" $wire0 "name" "step1" "arg0" "inspect" "arg1" $slot0 "arg2" $slot1

@output rows.project
"rows" $wire3 "name" "store" "arg0" $slot0 "arg1" $slot1
