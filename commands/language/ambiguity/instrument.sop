@input input
@text data.get source $input key "text"
@tokens text.tokenize text $text
@sentence data.prepend value "sentence" items $tokens
@facts data.sequence arg0 $sentence
@p logic.variable
@q logic.variable
@t logic.variable
@seed bindings.unit
@match relation.join rows $seed facts $facts name "sentence"
arg0 $p arg1 "saw" arg2 $q arg3 "with" arg4 "the" arg5 $t arg6 "."
@output rows.project rows $match name "interpretation"
arg0 "instrument" arg1 $p arg2 $q arg3 $t
