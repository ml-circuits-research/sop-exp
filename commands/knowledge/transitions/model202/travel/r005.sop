# Supplied transition program. The experiment tests execution, not transition induction.
@input input
@event frame.event source $input
@state frame.state source $input
@h0 logic.variable
@p0 logic.variable
@p1 logic.variable
@seed bindings.unit
@q0 relation.join rows $seed facts $event name "travel" arg0 $p0 arg1 $p1
@q1 relation.join rows $q0 facts $state name "at" arg0 $p0 arg1 $h0
@q2 logic.notEqual rows $q1 left $h0 right $p0
@q3 logic.notEqual rows $q2 left $h0 right $p1
@effect effect.remove rows $q3 name "at" arg0 $p0 arg1 $h0
@output value.identity value $effect
